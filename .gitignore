# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/

# --- VS Code -----------------------------------------------------------------
# Konfigurasi bersama (settings, launch, tasks, extensions) sengaja ikut masuk
# repo supaya di komputer lain tinggal buka folder dan langsung jalan.
# Yang diabaikan hanya file pribadi tiap orang.
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# --- Editor lain -------------------------------------------------------------
.idea/
*.swp

# --- Windows -----------------------------------------------------------------
Thumbs.db
desktop.ini

# --- Data untuk evaluasi -----------------------------------------------------
# Berkas ini besar (23 MB) dan diunduh otomatis oleh evaluasi.py saat pertama
# dipakai, jadi tidak perlu ikut disimpan di repo.
data/

# --- Hasil sementara ---------------------------------------------------------
# Suara gTTS sebenarnya disimpan di folder TEMP sistem, tapi kalau ada yang
# menyalinnya ke sini, jangan ikut masuk repo.
*.mp3

# Catatan jalannya program, dibuat baru setiap kali dijalankan.
log/

# Gambar bentuk huruf, dibuat ulang dengan lihat_huruf.py.
bentuk/
